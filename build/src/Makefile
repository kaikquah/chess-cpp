	cd /Users/quahkk/Downloads/chesscpp/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/chessbot_engine.dir/build.make src/CMakeFiles/chessbot_engine.dir/uci/uci.cpp.s
.PHONY : uci/uci.cpp.s

